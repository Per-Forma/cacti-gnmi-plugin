# Copy this file to .env before starting the lab. The repository-wide
# .gitignore excludes .env. Every credential below is TEST-ONLY and must not be
# reused outside this disposable, protected-network integration environment.

TZ=UTC

# Keep writable state outside version control.
LAB_STATE_DIR=./.state/cacti

# Bind the disposable Cacti UI to the local host by default.
CACTI_UI_BIND=127.0.0.1
CACTI_UI_PORT=7083
CACTI_MGMT_IPV4=10.253.0.20

MARIADB_DATABASE=cacti
MARIADB_USER=cacti
MARIADB_PASSWORD=replace-with-test-only-password
MARIADB_ROOT_PASSWORD=replace-with-test-only-root-password

# cacti-bootstrap.sh sets this through Cacti's PHP/database interfaces.
CACTI_ADMIN_USER=admin
CACTI_ADMIN_PASSWORD=replace-with-test-only-admin-password

# Refuse an image build when either filesystem has less than these margins.
MIN_DOCKER_FREE_GB=15
MIN_STATE_FREE_GB=5
