# Pinned Cacti runtime for integration and compatibility validation.
FROM php:8.5-apache-trixie

ARG CACTI_VERSION=1.2.31
ARG CACTI_COMMIT=1e8eaca26b84b128c39ce8cc8ece42d7ff76aac1
ARG CACTI_TARBALL_SHA256=fcc37e877e3e4c937a9cd245101784bc0961a0652f542660e8dce1e86c4e3a15

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cron \
      curl \
      default-mysql-client \
      fping \
      iputils-ping \
      libffi-dev \
      libfreetype6-dev \
      libgmp-dev \
      libicu-dev \
      libjpeg-dev \
      libldap2-dev \
      libonig-dev \
      libpng-dev \
      librrd-dev \
      libsnmp-dev \
      libxml2-dev \
      libzip-dev \
      pkg-config \
      procps \
      python3 \
      python3-dev \
      python3-venv \
      rrdtool \
      snmp \
      unzip \
      zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install -j"$(nproc)" \
      bcmath \
      gd \
      gmp \
      intl \
      ldap \
      mbstring \
      mysqli \
      pcntl \
      pdo_mysql \
      snmp \
      sockets \
      zip

RUN a2enmod headers rewrite \
 && cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini \
 && { \
      echo 'date.timezone = UTC'; \
      echo 'memory_limit = 512M'; \
      echo 'max_execution_time = 120'; \
      echo 'max_input_time = 120'; \
      echo 'post_max_size = 32M'; \
      echo 'upload_max_filesize = 32M'; \
    } > /usr/local/etc/php/conf.d/cacti.ini \
 && { \
      echo '<Directory /var/www/html/cacti>'; \
      echo '    AllowOverride All'; \
      echo '    Require all granted'; \
      echo '</Directory>'; \
    } > /etc/apache2/conf-available/cacti.conf \
 && a2enconf cacti

RUN curl -fsSL --retry 3 \
      -o /tmp/cacti.tar.gz \
      "https://github.com/Cacti/cacti/archive/${CACTI_COMMIT}.tar.gz" \
 && echo "${CACTI_TARBALL_SHA256}  /tmp/cacti.tar.gz" | sha256sum -c - \
 && mkdir -p /var/www/html/cacti \
 && tar -xzf /tmp/cacti.tar.gz --strip-components=1 -C /var/www/html/cacti \
 && rm -f /tmp/cacti.tar.gz /var/www/html/cacti/include/config.php \
 && mkdir -p /var/www/html/cacti/{cache,log,plugins,rra} \
 && chown -R www-data:www-data /var/www/html/cacti

LABEL org.opencontainers.image.title="Cacti gNMI integration test" \
      org.opencontainers.image.version="${CACTI_VERSION}" \
      org.opencontainers.image.revision="${CACTI_COMMIT}" \
      org.opencontainers.image.source="https://github.com/Cacti/cacti"

COPY cacti-entrypoint.sh /usr/local/bin/cacti-entrypoint
COPY render-config.php bootstrap-admin.php /usr/local/lib/cacti-lab/

RUN chmod 0755 /usr/local/bin/cacti-entrypoint \
 && chmod 0644 /usr/local/lib/cacti-lab/*.php \
 && { \
      echo 'SHELL=/bin/sh'; \
      echo 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'; \
      echo '* * * * * www-data php /var/www/html/cacti/poller.php >>/var/www/html/cacti/log/poller-cron.log 2>&1'; \
    } > /etc/cron.d/cacti \
 && chmod 0644 /etc/cron.d/cacti

WORKDIR /var/www/html/cacti
EXPOSE 80

ENTRYPOINT ["/usr/local/bin/cacti-entrypoint"]
CMD ["apache2-foreground"]
