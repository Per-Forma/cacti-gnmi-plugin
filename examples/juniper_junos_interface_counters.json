{
  "_comment": "Reference template for the Cacti gNMI plugin. Transcribe into the device edit form; this is not an import file. See examples/README.md.",
  "platform": "Juniper Junos",
  "path_style": "OpenConfig",
  "connection": {
    "port": 32767,
    "port_note": "Junos gNMI/gRPC commonly listens on 32767 (or 9339 for the native gNMI service). Confirm on your device.",
    "use_tls": true,
    "encoding": "JSON_IETF"
  },
  "subscriptions": [
    {
      "path": "openconfig-interfaces:interfaces/interface[name=ge-0/0/0]/state/counters",
      "instance": "ge-0-0-0",
      "metrics": [
        { "metric_name": "in-octets",         "cacti_field_name": "in_octets",     "rrd_type": "COUNTER" },
        { "metric_name": "out-octets",        "cacti_field_name": "out_octets",    "rrd_type": "COUNTER" },
        { "metric_name": "in-unicast-pkts",   "cacti_field_name": "in_ucast_pkts", "rrd_type": "COUNTER" },
        { "metric_name": "out-unicast-pkts",  "cacti_field_name": "out_ucast_pkts","rrd_type": "COUNTER" },
        { "metric_name": "in-errors",         "cacti_field_name": "in_errors",     "rrd_type": "COUNTER" },
        { "metric_name": "out-errors",        "cacti_field_name": "out_errors",    "rrd_type": "COUNTER" },
        { "metric_name": "in-discards",       "cacti_field_name": "in_discards",   "rrd_type": "COUNTER" },
        { "metric_name": "out-discards",      "cacti_field_name": "out_discards",  "rrd_type": "COUNTER" }
      ]
    }
  ]
}
